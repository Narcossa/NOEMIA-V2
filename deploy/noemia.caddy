# /etc/caddy/sites/noemia.caddy — importé depuis /etc/caddy/Caddyfile
# Serveur de NOÉMIA : HTTPS automatique (Let's Encrypt) sur le nom du VPS, relais vers Node.
vps-1d994dff.vps.ovh.ca {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# flush_interval -1 : les réponses de NOÉMIA sont transmises au fil de l'eau
	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
	}
}
